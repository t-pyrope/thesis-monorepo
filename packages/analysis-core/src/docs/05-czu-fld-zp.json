      "definition": "structure.type_specific",
      "severity": "warning",
      "parameters": {
        "required_sections": [
          "literature_review",
          "input_analysis",
          "methodology",
          "study_area_if_relevant",
          "results",
          "discussion",
          "conclusion_and_contribution"
        ]
      }
    },
    {
      "rule_id": "type.inventory",
      "definition": "structure.type_specific",
      "severity": "warning",
      "parameters": {
        "required_sections": [
          "literature_review",
          "study_area",
          "methodology",
          "results_and_management_proposal",
          "discussion",
          "conclusion"
        ]
      }
    },
    {
      "rule_id": "type.project_documentation",
      "definition": "structure.type_specific",
      "severity": "warning",
      "parameters": {
        "required_sections": [
          "literature_review",
          "technical_report",
