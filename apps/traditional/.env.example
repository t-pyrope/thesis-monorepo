OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=
APP_PASSWORD_HASH=
PORT=3000
# Enable only behind a trusted proxy such as Render.
TRUST_PROXY=false
# Exact FE origin(s), comma separated, optional trailing slash. No paths or *.
ALLOWED_ORIGINS=http://localhost:3001
# Use none for FE and BE on different sites, lax for same-site deployments.
# Cookies always require HTTPS.
COOKIE_SAME_SITE=lax
