PORT=3000
TRUST_PROXY=false
COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=
SESSION_SECRET=
APP_PASSWORD_HASH=
# Existing login and IP rate limit configuration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Worker only
OPENAI_API_KEY=
# TCP Redis for BullMQ (not the Upstash REST endpoint)
REDIS_URL=redis://127.0.0.1:6379
# Private S3-compatible bucket shared by API and worker
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
